# ==============================================================================
# Multilingual Hospital AI Agent System - Environment Configuration
# Copy this file to .env and configure your credentials.
# ==============================================================================

# --- Google Gemini API Configuration ---
# Your Google AI Studio API key (required for Gemini LLM and ADK)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini model identifier for ADK multi-agent text orchestration (gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Gemini Realtime Multimodal Voice model (supports bidiGenerateContent bidirectional audio)
GEMINI_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- LiveKit Voice Configuration ---
# Required for running the real-time voice session (Milestone 2 & 3)
# Get credentials from your LiveKit Cloud project or local LiveKit server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Hospital & Clinic Configuration ---
# Local timezone for the clinic (default: Asia/Kolkata)
HOSPITAL_TIMEZONE=Asia/Kolkata

# Path to the SQLite database file
DATABASE_PATH=hospital.db

# Config file path
CONFIG_PATH=config/hospital_config.yaml

# Receptionist & Emergency handoff phone numbers
RECEPTIONIST_PHONE=+91-44-2499-1000
EMERGENCY_HOTLINE=+91-44-2499-1066

# --- Operational Flags ---
# Set to true for synthetic demo data; set to false in production
DEMO_MODE=true

# Conversation debugging (false by default to prevent logging sensitive PHI)
DEBUG_CONVERSATION_LOGGING=false
